# Local development only. Copy to .env and set your own password.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agora
DB_USERNAME=postgres
DB_PASSWORD=change-me
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
SESSION_COOKIE_SECURE=false
# Enable only after setting the same random URL-safe token in the participating services.
IDENTITY_GRPC_ENABLED=false
IDENTITY_GRPC_PORT=9091
INTERSERVICE_TOKEN=
MERCHANT_SERVER_PORT=8082
MERCHANT_DB_NAME=agora_merchant
MERCHANT_GRPC_ENABLED=false
MERCHANT_GRPC_PORT=9092
CATALOG_DB_NAME=agora_catalog
CATALOG_SERVER_PORT=8083
CATALOG_GRPC_ENABLED=false
CATALOG_GRPC_PORT=9093
COMMERCE_DB_NAME=agora_commerce
COMMERCE_SERVER_PORT=8084
# Set real values only in ignored .env, never in this example.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
