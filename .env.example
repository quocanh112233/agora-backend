# Local development only. Copy to .env and set your own password.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agora
DB_USERNAME=postgres
DB_PASSWORD=change-me
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
SESSION_COOKIE_SECURE=false
# Enable only after setting the same random URL-safe token in the participating services.
IDENTITY_GRPC_ENABLED=false
IDENTITY_GRPC_PORT=9091
INTERSERVICE_TOKEN=
MERCHANT_SERVER_PORT=8082
MERCHANT_DB_NAME=agora_merchant
MERCHANT_GRPC_ENABLED=false
MERCHANT_GRPC_PORT=9092
CATALOG_DB_NAME=agora_catalog
CATALOG_SERVER_PORT=8083
CATALOG_GRPC_ENABLED=false
CATALOG_GRPC_PORT=9093
COMMERCE_DB_NAME=agora_commerce
COMMERCE_SERVER_PORT=8084
COMMERCE_GRPC_ENABLED=false
COMMERCE_GRPC_PORT=9094
FEEDBACK_DB_NAME=agora_feedback
FEEDBACK_SERVER_ADDRESS=127.0.0.1
FEEDBACK_SERVER_PORT=8086
PAYMENT_DB_NAME=agora_payment
PAYMENT_SERVER_ADDRESS=127.0.0.1
PAYMENT_SERVER_PORT=8085
# Sandbox only. Enable new attempts after configuring the merchant credentials locally.
VNPAY_ENABLED=false
# Portfolio only opens VNPAY sandbox and validates Return; automatic confirmation is out of scope.
VNPAY_QUERY_ENABLED=false
VNPAY_IPN_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://127.0.0.1:3000/api/v1/payments/vnpay/return
# Set real values only in ignored .env, never in this example.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email links: fill SMTP values locally; enable delivery after starting email-service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
EMAIL_DB_NAME=agora_email
EMAIL_SERVER_PORT=8087
EMAIL_GRPC_PORT=9095
EMAIL_GRPC_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
EMAIL_GRPC_HOST=127.0.0.1
EMAIL_TOKEN_ENCRYPTION_KEY=
