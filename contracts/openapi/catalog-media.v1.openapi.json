            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Stable UUID per intent; retries must keep the original file or payload."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Exactly one file part; maximum 5242880 bytes; JPEG or PNG."
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
