  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "AGORA_SESSION"
      },
      "CsrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "Upload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uploadId": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "uploadId",
          "productId",
          "expiresAt"
        ]
      },
      "Image": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://res\\.cloudinary\\.com/"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000000
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000000
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5242880
          },
          "format": {
            "type": "string",
            "enum": [
              "jpg",
              "png"
            ]
          }
        },
        "required": [
          "id",
          "url",
          "width",
          "height",
          "bytes",
          "format"
        ]
      },
      "ProductImages": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "productVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          }
        },
        "required": [
          "productId",
          "productVersion",
          "items"
        ]
      },
      "AttachImage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uploadId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "uploadId",
          "expectedVersion"
        ]
      },
      "DetachImage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "expectedVersion"
        ]
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "code",
          "message",
          "traceId",
          "details"
        ]
      }
    }
  }
