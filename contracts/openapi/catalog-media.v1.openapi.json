  "openapi": "3.1.0",
  "info": {
    "title": "Agora Catalog Media API",
    "version": "1.1.0",
    "description": "Private DRAFT or HIDDEN product images for the current ACTIVE shop owner; hide a PUBLISHED product before managing images. Upload and attachment are separate. Only server-proxied JPEG/PNG at most 5 MiB and 20 million pixels, max 5 attached images; private no-store responses. Visibility is managed through the Catalog contract, never through arbitrary URL/public_id attachment."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8083/api/v1"
    }
  ],
  "tags": [
