{
  "openapi": "3.1.0",
  "info": {
    "title": "Agora own account profile",
    "version": "1.0.0",
    "description": "Own-account editing only, CSRF for mutations. Profile version independent from authentication version. Email change needs current password and new-address link, then revokes sessions. Avatar client uploadId binds owner/file/version; inspect profile after uncertain outcome, never retry blindly. No role/type/selfdelete/session-device APIs."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/me/profile": {
      "get": {
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected safely"
          },
