              }
            }
          },
          "400": {
            "description": "Request rejected safely"
          },
          "401": {
            "description": "Request rejected safely"
          },
          "403": {
            "description": "Request rejected safely"
          },
          "409": {
            "description": "Request rejected safely"
          },
          "413": {
            "description": "Request rejected safely"
          },
          "415": {
            "description": "Request rejected safely"
          },
          "422": {
            "description": "Request rejected safely"
          },
          "429": {
            "description": "Request rejected safely"
          },
          "503": {
            "description": "Request rejected safely"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          }
        }
      }
    },
    "/me/avatar": {
      "put": {
        "operationId": "uploadAvatar",
        "responses": {
          "200": {
