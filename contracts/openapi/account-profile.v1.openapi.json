          },
          "422": {
            "description": "Request rejected safely"
          },
          "429": {
            "description": "Request rejected safely"
          },
          "503": {
            "description": "Request rejected safely"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/AvatarUpload"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "removeAvatar",
        "responses": {
