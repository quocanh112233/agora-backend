  "components": {
    "schemas": {
      "Avatar": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 512
          }
        }
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "email",
          "displayName",
          "version",
          "avatar"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "avatar": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Avatar"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ProfileUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "expectedVersion"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          }
        }
      },
      "VersionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedVersion"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          }
        }
      },
      "EmailChangeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currentPassword",
          "newEmail"
        ],
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          },
          "newEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        }
      },
      "TokenConfirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          }
        }
      },
      "AvatarUpload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "uploadId",
          "expectedVersion"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary"
          },
          "uploadId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,15})$"
          }
        }
      }
    }
  }
}
