{
  "openapi": "3.1.0",
  "info": {
    "title": "Agora Payment API",
    "version": "1.0.2",
    "description": "VNPAY sandbox redirect and authenticated Return only for portfolio. Merchant TMN code and HMAC secret are still required. IPN and querydr/automatic provider reconciliation are disabled by default and out of portfolio scope. Return correlates but does not record capture or mark PAID. Existing money/stock validation remains intact; there is no fake payment simulator. Legacy callback/reconciliation tests can opt in explicitly."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/me/orders/{orderId}/payment-attempts": {
      "post": {
        "operationId": "createPaymentAttempt",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentAttempt"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current attempt for exact actor/key/order replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentAttempt"
                }
              }
            }
          },
          "201": {
            "description": "New durable attempt; URL/deadline never regenerated on replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentAttempt"
                }
              }
            }
          },
          "400": {
            "description": "Malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Current session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "CSRF or permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Owned resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Order/attempt cannot start another charge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid identity/fields or key reused for another order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency or provider configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me/payment-attempts/by-request-key/{requestKey}": {
      "get": {
        "operationId": "getPaymentAttemptByRequestKey",
        "parameters": [
          {
            "name": "requestKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned current projection; 404 is not proof a concurrent POST failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentAttempt"
                }
              }
            }
          },
          "400": {
            "description": "Malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Current session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "CSRF or permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Owned resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Order/attempt cannot start another charge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid identity/fields or key reused for another order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency or provider configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me/payment-attempts/{attemptId}": {
      "get": {
        "operationId": "getPaymentAttempt",
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned current projection; 404 is not proof a concurrent POST failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentAttempt"
                }
              }
            }
          },
          "400": {
            "description": "Malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Current session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "CSRF or permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Owned resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Order/attempt cannot start another charge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid identity/fields or key reused for another order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency or provider configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/payments/vnpay/ipn": {
      "get": {
        "operationId": "vnpayIpn",
        "security": [],
        "description": "Optional legacy callback, disabled by default (VNPAY_IPN_ENABLED=false). Not used or proxied by the portfolio frontend. Existing IPN codec/storage tests can opt in explicitly. Return remains available; querydr is also disabled by default (VNPAY_QUERY_ENABLED=false) and out of portfolio scope.",
        "parameters": [
          {
            "name": "vnp_TmnCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          {
            "name": "vnp_TxnRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "vnp_Amount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12
            }
          },
          {
            "name": "vnp_TransactionNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 15
            }
          },
          {
            "name": "vnp_ResponseCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          },
          {
            "name": "vnp_TransactionStatus",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          },
          {
            "name": "vnp_SecureHash",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "vnp_BankCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            }
          },
          {
            "name": "vnp_PayDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 14
            }
          },
          {
            "name": "vnp_OrderInfo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Durable handling acknowledgement, not an order payment guarantee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpnAcknowledgement"
                }
              }
            }
          }
        }
      }
    },
    "/payments/vnpay/return": {
      "get": {
        "operationId": "vnpayReturn",
        "security": [],
        "description": "Verify/correlate only; no capture or PAID write. Provider query enqueue is disabled by default (VNPAY_QUERY_ENABLED=false) and out of portfolio scope. Redirect to fixed frontend with opaque refs.",
        "parameters": [
          {
            "name": "vnp_TmnCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          {
            "name": "vnp_TxnRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "vnp_Amount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12
            }
          },
          {
            "name": "vnp_TransactionNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 15
            }
          },
          {
            "name": "vnp_ResponseCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          },
          {
            "name": "vnp_TransactionStatus",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          },
          {
            "name": "vnp_SecureHash",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "vnp_BankCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            }
          },
          {
            "name": "vnp_PayDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 14
            }
          },
          {
            "name": "vnp_OrderInfo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Fixed same-origin frontend order/status location; monetary state must be read from authenticated APIs",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Invalid return checksum or binding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Configuration/storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "AGORA_SESSION"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "code",
          "message",
          "traceId",
          "details"
        ]
      },
      "CreatePaymentAttempt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "PaymentAttempt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "orderId",
          "requestKey",
          "state",
          "expiresAt",
          "redirectUrl",
          "applicationState",
          "refundState",
          "needsReconciliation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "requestKey": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "FAILED",
              "EXPIRED",
              "SUCCEEDED"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "redirectUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "maxLength": 4096,
                "pattern": "^https://sandbox\\.vnpayment\\.vn/paymentv2/vpcpay\\.html\\?"
              },
              {
                "type": "null"
              }
            ]
          },
          "applicationState": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PROCESSING",
                  "APPLIED",
                  "REFUND_REQUIRED"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "refundState": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "RESERVED",
                  "PENDING",
                  "SUCCEEDED",
                  "NEEDS_RECONCILIATION"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "needsReconciliation": {
            "type": "boolean"
          }
        }
      },
      "IpnAcknowledgement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "RspCode",
          "Message"
        ],
        "properties": {
          "RspCode": {
            "type": "string",
            "enum": [
              "00",
              "01",
              "02",
              "04",
              "97",
              "99"
            ]
          },
          "Message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    }
  }
}
