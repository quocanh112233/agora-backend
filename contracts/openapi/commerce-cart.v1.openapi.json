{
  "openapi": "3.1.0",
  "info": {
    "title": "Agora Commerce Cart API",
    "version": "1.0.0",
    "description": "Authenticated persistent cart, maximum 20 distinct SKUs and 1–99 packages per line. No stock hold or checkout. Versioned/idempotent mutations; fresh offers on reads. Unknown queries and fields are rejected. cartId is an opaque, stable owner-bound identifier; mutations reject cartId from a previous account."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8084/api/v1"
    }
  ],
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/me/cart": {
      "get": {
        "operationId": "getMyCart",
        "summary": "Read current account cart with fresh Catalog offers",
        "responses": {
          "200": {
            "description": "Current cart; unavailable lines retain references with offer null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Current session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "CSRF denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Cart version, limit or product availability conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid fields or idempotency payload mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me/cart/items/{skuId}": {
      "put": {
        "operationId": "putCartItem",
        "summary": "Set absolute package quantity",
        "parameters": [
          {
            "name": "skuId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartPut"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed version, or original idempotent replay version; fetch cart again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartMutation"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Current session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "CSRF denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Cart version, limit or product availability conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid fields or idempotency payload mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteCartItem",
        "summary": "Remove an owned cart line without Catalog dependency",
        "parameters": [
          {
            "name": "skuId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartDelete"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed version, or original idempotent replay version; fetch cart again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartMutation"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Current session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "CSRF denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Cart version, limit or product availability conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid fields or idempotency payload mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "AGORA_SESSION"
      }
    },
    "schemas": {
      "CartImage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "width",
          "height"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://res\\.cloudinary\\.com/[A-Za-z0-9_-]+/image/upload/v[1-9][0-9]*/agora/products/[0-9a-f-]{36}/[0-9a-f-]{36}\\.(jpg|png)$",
            "maxLength": 512
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000000
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000000
          }
        }
      },
      "CartOffer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "skuId",
          "shopId",
          "shopName",
          "productName",
          "skuLabel",
          "priceVnd",
          "netWeightGrams",
          "inStock",
          "thumbnail"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "skuId": {
            "type": "string",
            "format": "uuid"
          },
          "shopId": {
            "type": "string",
            "format": "uuid"
          },
          "shopName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "productName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "skuLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "priceVnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "netWeightGrams": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          },
          "inStock": {
            "type": "boolean"
          },
          "thumbnail": {
            "$ref": "#/components/schemas/CartImage"
          }
        }
      },
      "CartItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "skuId",
          "quantity",
          "offer"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "skuId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "offer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CartOffer"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Cart": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cartId",
          "version",
          "items"
        ],
        "properties": {
          "cartId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          }
        }
      },
      "CartPut": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cartId",
          "productId",
          "quantity",
          "expectedVersion"
        ],
        "properties": {
          "cartId": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "CartDelete": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cartId",
          "expectedVersion"
        ],
        "properties": {
          "cartId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "CartMutation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "code",
          "message",
          "traceId",
          "details"
        ]
      }
    }
  }
}
