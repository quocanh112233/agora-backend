{
  "openapi": "3.1.0",
  "info": {
    "title": "Agora Catalog API",
    "version": "1.1.0",
    "description": "Seller product management: DRAFT and HIDDEN content/SKUs are editable, PUBLISHED is read-only until hidden. Visibility requires a current ACTIVE owned shop, a version guard, and at least one attached verified image before publishing. Every request/replay resolves the current Identity session and ACTIVE shop through gRPC. Public browse, inventory and checkout remain outside this revision; Cloudinary media has a separate contract. All responses are no-store. Integer bounds are MVP input limits, not GHN acceptance guarantees."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8083/api/v1",
      "description": "Local loopback Catalog"
    }
  ],
  "tags": [
    {
      "name": "Seller products",
      "description": "Only the current owner of an ACTIVE shop can manage products."
    }
  ],
