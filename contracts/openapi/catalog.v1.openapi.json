  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "AGORA_SESSION"
      },
      "CsrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "SkuInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,39}$",
            "minLength": 1,
            "maxLength": 40
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 100
          },
          "priceVnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000,
            "format": "int64"
          },
          "netWeightGrams": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          },
          "shippingWeightGrams": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000,
            "description": "Must be at least netWeightGrams."
          },
          "lengthCm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "widthCm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "heightCm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "code",
          "label",
          "priceVnd",
          "netWeightGrams",
          "shippingWeightGrams",
          "lengthCm",
          "widthCm",
          "heightCm"
        ]
      },
      "Sku": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,39}$",
            "minLength": 1,
            "maxLength": 40
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 100
          },
          "priceVnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000,
            "format": "int64"
          },
          "netWeightGrams": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          },
          "shippingWeightGrams": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000,
            "description": "Must be at least netWeightGrams."
          },
          "lengthCm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "widthCm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "heightCm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "saleUnit": {
            "type": "string",
            "const": "PACKAGE"
          }
        },
        "required": [
          "id",
          "code",
          "label",
          "priceVnd",
          "netWeightGrams",
          "shippingWeightGrams",
          "lengthCm",
          "widthCm",
          "heightCm",
          "saleUnit"
        ]
      },
      "ProductCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "pattern": "\\S",
            "maxLength": 160
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "enum": [
              "PRODUCE",
              "SEAFOOD"
            ]
          },
          "condition": {
            "type": "string",
            "enum": [
              "FRESH",
              "FROZEN",
              "DRIED",
              "PROCESSED"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 120
          },
          "producerName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "storageInstructions": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 1000
          },
          "skus": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/SkuInput"
            },
            "description": "Distinct codes, unique within the shop."
          }
        },
        "required": [
          "name",
          "category",
          "condition",
          "origin",
          "storageInstructions",
          "skus"
        ]
      },
      "ProductUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "pattern": "\\S",
            "maxLength": 160
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "enum": [
              "PRODUCE",
              "SEAFOOD"
            ]
          },
          "condition": {
            "type": "string",
            "enum": [
              "FRESH",
              "FROZEN",
              "DRIED",
              "PROCESSED"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 120
          },
          "producerName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
