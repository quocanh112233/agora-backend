{
  "openapi": "3.1.0",
  "info": {
    "title": "Agora Catalog Inventory API",
    "version": "1.0.0",
    "description": "Seller lots for any DRAFT/HIDDEN/PUBLISHED product of current ACTIVE owner. Counts are integer packages. Produced date optional, expiry required; a lot expires at 00:00 Asia/Ho_Chi_Minh on expiresOn, never scheduler-dependent. available is physical onHand-held-allocated and does not imply eligible stock. BLOCKED takes precedence over EXPIRED then DEPLETED. No reservation, quantity adjustment or checkout here. Mutations accept one strict JSON object at most 2048 bytes, enforce current permission/CSRF before replay, and retain immutable snapshots for 7 days; replay is historical, fresh list determines current status. A referenced SKU cannot be removed/renamed or have its physical package changed; price/label can change."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8083/api/v1"
    }
  ],
  "paths": {
