    "/seller/products/{productId}/lots/{lotId}/status": {
      "put": {
        "operationId": "changeInventoryLotStatus",
        "tags": [
          "Inventory lots"
        ],
        "x-service": "catalog-service",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
