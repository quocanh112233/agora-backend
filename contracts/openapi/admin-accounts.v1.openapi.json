  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "AGORA_SESSION",
        "description": "HttpOnly, SameSite=Lax, Path=/, Secure trên HTTPS; idle 30 phút. Không lưu session ID trong JS."
      }
    },
    "responses": {
      "Unavailable": {
        "description": "503 — Dependency bắt buộc không sẵn sàng; không bỏ auth.",
        "headers": {
          "Cache-Control": {
            "description": "Không cache response riêng hoặc token.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Trace-Id": {
            "description": "Correlation identifier; không chứa secret.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "500 — Lỗi nội bộ đã che chi tiết.",
        "headers": {
          "Cache-Control": {
            "description": "Không cache response riêng hoặc token.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Trace-Id": {
