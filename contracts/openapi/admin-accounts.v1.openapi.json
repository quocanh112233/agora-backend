            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequest": {
        "description": "400 — JSON hoặc tham số cú pháp không đọc được.",
        "headers": {
          "Cache-Control": {
            "description": "Không cache response riêng hoặc token.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Trace-Id": {
            "description": "Correlation identifier; không chứa secret.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "code",
          "message",
          "traceId"
        ]
      },
      "StatusHistoryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/StatusHistory"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "StatusHistory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "targetId",
          "actorId",
          "actorDisplayName",
          "previousStatus",
          "status",
          "reason",
          "version",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "actorDisplayName": {
            "type": "string"
          },
          "previousStatus": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StatusChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "expectedVersion",
          "reason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "description": "Trim trước kiểm tra; giới hạn theo Unicode code points."
          }
        }
      },
      "Shop": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "contactPhone": {
            "type": "string",
            "minLength": 9,
            "maxLength": 20
          },
          "pickupAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "status": {
            "$ref": "#/components/schemas/ShopStatus"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "lastReviewReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "ownerAccountId",
          "name",
          "description",
          "contactPhone",
          "pickupAddress",
          "status",
          "version",
          "lastReviewReason",
          "createdAt",
          "updatedAt"
        ]
      },
      "ShopStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "PENDING_REVIEW",
          "ACTIVE",
          "REJECTED",
          "SUSPENDED"
        ]
      },
      "Address": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "countryCode": {
            "type": "string",
            "const": "VN"
          },
          "provinceCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "provinceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "wardCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "wardName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "streetAddress": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "countryCode",
          "provinceCode",
          "provinceName",
          "wardCode",
          "wardName",
          "streetAddress"
        ]
      },
      "AdminAccount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "USER",
                "ADMIN"
              ]
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "accountType": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "BUYER",
              "SELLER",
              null
            ],
            "description": "null chỉ cho tài khoản legacy chưa được operator phân loại; không cấp quyền mua/bán."
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "roles",
          "status",
          "createdAt",
          "accountType",
          "version",
          "updatedAt"
        ]
      },
      "AdminAccountPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/AdminAccount"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      }
    },
    "parameters": {
      "Csrf": {
        "name": "X-CSRF-TOKEN",
        "in": "header",
        "required": true,
        "description": "Lấy từ /auth/csrf; lấy lại sau login/logout.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
