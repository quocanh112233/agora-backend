{
  "openapi": "3.1.0",
  "info": {
    "title": "Agora admin accounts and shop moderation",
    "version": "1.0.0",
    "description": "Unreleased contract. Current ADMIN checked from Identity on every operation; no role-change or account-type-change API. Protect all ADMIN targets and self from account status writes. Writes require fresh CSRF, expectedVersion, reason; stale/same-state409. Cursor20 bound to filters/target. Missing/duplicate/unknown params422; UUID canonical. Account suspension atomically increments version, audits and revokes sessions. Shop suspension separate; restore requires ACTIVE SELLER owner. No automatic cancellation/refund of previous orders. Implement/read-only slice first; status routes only after session guards and owner gate complete."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin routing; local rewrites theo allowlist."
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "tags": [
    {
      "name": "Administration"
    }
  ],
