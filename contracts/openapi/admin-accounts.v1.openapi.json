              "format": "uuid"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "422 — Input không hợp lệ, field lạ hoặc key đổi payload.",
        "headers": {
          "Cache-Control": {
            "description": "Không cache response riêng hoặc token.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Trace-Id": {
            "description": "Correlation identifier; không chứa secret.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "409 — Trạng thái/version xung đột, email/shop đã tồn tại hoặc idempotency đang chạy.",
        "headers": {
          "Cache-Control": {
            "description": "Không cache response riêng hoặc token.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Trace-Id": {
            "description": "Correlation identifier; không chứa secret.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "404 — Không có tài nguyên hoặc không thuộc owner.",
        "headers": {
          "Cache-Control": {
            "description": "Không cache response riêng hoặc token.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Trace-Id": {
            "description": "Correlation identifier; không chứa secret.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "403 — Thiếu quyền hoặc CSRF không hợp lệ.",
        "headers": {
          "Cache-Control": {
            "description": "Không cache response riêng hoặc token.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Trace-Id": {
            "description": "Correlation identifier; không chứa secret.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "401 — Chưa đăng nhập, hết phiên hoặc sai credential.",
        "headers": {
          "Cache-Control": {
            "description": "Không cache response riêng hoặc token.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Trace-Id": {
            "description": "Correlation identifier; không chứa secret.",
            "schema": {
