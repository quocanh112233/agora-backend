          "status": {
            "$ref": "#/components/schemas/ShopStatus"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "lastReviewReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
