  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "AGORA_SESSION",
        "description": "HttpOnly, SameSite=Lax, Path=/, Secure trên HTTPS; idle 30 phút. Không lưu session ID trong JS."
      }
    },
    "parameters": {
      "Csrf": {
        "name": "X-CSRF-TOKEN",
        "in": "header",
        "required": true,
        "description": "Lấy từ /auth/csrf; lấy lại sau login/logout.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "UUID ổn định cho một ý định; scope actor+operation. Payload khác 422; đang chạy 409; xong replay; retention onboarding ít nhất 7 ngày.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ShopId": {
        "name": "shopId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "code",
          "message",
          "traceId"
        ]
      },
      "CsrfToken": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "headerName": {
            "type": "string",
            "const": "X-CSRF-TOKEN"
          }
        },
        "required": [
          "token",
          "headerName"
        ]
      },
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "USER",
                "ADMIN"
              ]
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "accountType": {
            "type": "string",
            "enum": [
              "BUYER",
              "SELLER"
            ],
            "description": "Loại cố định theo endpoint đăng ký, độc lập với role USER/ADMIN."
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "roles",
          "status",
          "createdAt",
          "accountType"
        ]
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
