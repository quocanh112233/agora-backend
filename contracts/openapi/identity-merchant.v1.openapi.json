        "required": [
          "id",
          "ownerAccountId",
          "name",
          "description",
          "contactPhone",
          "pickupAddress",
          "status",
          "version",
          "lastReviewReason",
          "createdAt",
          "updatedAt"
        ]
      },
      "ShopSubmit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "expectedVersion"
        ]
      },
      "ShopReview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        },
        "required": [
          "decision",
          "expectedVersion"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "REJECT"
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 1000
                }
              },
              "required": [
                "reason"
              ]
            }
          }
        ]
