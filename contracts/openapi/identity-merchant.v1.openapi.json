          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "contactPhone": {
            "type": "string",
            "minLength": 9,
            "maxLength": 20
          },
          "pickupAddress": {
            "$ref": "#/components/schemas/Address"
